{
  "name": "@selenium/mcp",
  "version": "0.1.0",
  "description": "The official Selenium MCP server: lets coding agents drive a real browser through Selenium",
  "license": "Apache-2.0",
  "keywords": [
    "automation",
    "browser",
    "mcp",
    "model-context-protocol",
    "selenium",
    "webdriver"
  ],
  "homepage": "https://github.com/SeleniumHQ/mcp#readme",
  "bugs": {
    "url": "https://github.com/SeleniumHQ/mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SeleniumHQ/mcp.git"
  },
  "main": "./lib/server.js",
  "bin": {
    "selenium-mcp": "bin/selenium-mcp.js"
  },
  "files": [
    "bin/",
    "lib/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >= 26.12.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "selenium-webdriver": "npm:@seleniumhq/selenium-webdriver@^4.53.0-0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-mocha": "^11.3.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "mocha": "^11.8.0",
    "prettier": "^3.9.10"
  },
  "scripts": {
    "lint": "eslint . && prettier . --check --ignore-unknown",
    "format": "prettier . --write --ignore-unknown",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "mocha --timeout 20000 --exit \"test/unit/*_test.js\"",
    "test:e2e": "mocha --timeout 60000 --retries 1 --exit \"test/e2e/*_test.js\""
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
