# Nightly selenium-webdriver builds live in GitHub Packages, which needs a token
# with read:packages even for public packages. Drop this, and point the dependency in
# package.json back at npm, once selenium-webdriver 4.53.0 is on npm.
@seleniumhq:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
